# Copy this file to .env.local and fill in real values before deploying.
# Locally, the contact form works fine with none of these set — it just
# logs the submission to the terminal instead of sending a real email.

# Resend (resend.com) — used by pages/api/contact.ts to email new leads.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# The address new leads get emailed to.
CONTACT_TO_EMAIL=carlos.simoni@cmadraft.com

# Must be a verified sender on your Resend domain once carlossimoni.com
# is registered and added to Resend. Until then, leave unset — the API
# route falls back to Resend's shared test sender, which only works in
# Resend's own sandbox/testing mode, not for real delivery.
CONTACT_FROM_EMAIL=
