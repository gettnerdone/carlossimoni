# Copy this file to .env.local and fill in real values before deploying.
# Locally, the contact form works fine with none of these set — it just
# logs the submission to the terminal instead of sending a real email.

# Resend (resend.com) — used by pages/api/contact.ts to email new leads.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# The address new leads get emailed to.
CONTACT_TO_EMAIL=carlos.simoni@cmadraft.com

# Must be a verified sender on your Resend domain once carlossimoni.com
# is registered and added to Resend. Until then, leave unset — the API
# route falls back to Resend's shared test sender, which only works in
# Resend's own sandbox/testing mode, not for real delivery.
CONTACT_FROM_EMAIL=

# ── Carlos CRM (pages/admin/vulcan7.tsx) ─────────────────────────────────
# TESTING ONLY: points at cmadraft's existing Postgres + Resend while this
# pipeline is being proven out. Must move to carlossimoni.com's own
# Postgres/Resend before any real send to real leads — never let this stay
# pointed at cmadraft in production (see docs/carlos-crm-schema.sql).

# Same Postgres instance cmadraft uses — copy POSTGRES_URL's value from
# cmadraft/.env.local. Only writes to the carlos_crm schema.
DATABASE_URL=

# Vulcan7 login (vulcan7dialer.com) — the account the daily sync logs in as.
VULCAN7_USERNAME=
VULCAN7_PASSWORD=

# Shared password for /admin/vulcan7 — there's no account system yet, just
# this one gate. Pick something long and random.
ADMIN_PASSWORD=

# Lets Vercel Cron (see vercel.json) trigger the daily sync without the
# admin cookie. Set the SAME value here as the CRON_SECRET env var in the
# Vercel project dashboard (Settings → Environment Variables) — Vercel
# sends it automatically as "Authorization: Bearer <value>" on scheduled
# runs. Not needed for local dev; only matters in production.
CRON_SECRET=

# Where the outreach dry-run summary email goes (never a lead's address).
ADMIN_EMAIL_TO=

# Outreach send-from. Defaults to carlos.simoni@cmadraft.com (testing) if
# unset. Set this to Carlos's own carlossimoni.com address once that
# domain is verified on his own Resend account.
OUTREACH_FROM_EMAIL=
OUTREACH_MAILING_ADDRESS=

# Only leads whose Vulcan7 date-added is on/after this date (YYYY-MM-DD)
# ever enter the outreach cadence -- the existing backlog of older leads
# is deliberately left out so go-live doesn't fire a day-1 email at all
# 300+ of them at once. Leave unset while dry-run testing against the
# current backlog; set it to the real go-live date before any real send.
OUTREACH_START_DATE=

# Set to the literal string "true" to let the daily outreach cron (once
# added to vercel.json) actually send real emails. Deliberately separate
# from CRON_SECRET -- having cron auth configured for the Vulcan7 sync
# should NOT silently also authorize real sends to leads the day someone
# adds an outreach cron entry. Leave unset until the domain, Resend
# account, and real email copy are all in place.
OUTREACH_AUTO_SEND=

# Signing secret for the Resend webhook (pages/api/webhooks/resend.ts),
# shown when you create the webhook in the Resend dashboard. Used to
# auto-opt-out any lead whose email bounces or gets marked as spam.
RESEND_WEBHOOK_SECRET=
